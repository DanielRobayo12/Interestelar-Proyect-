
<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ========= Xacro Import =========-->
    <xacro:include filename="$(find interestelar_pkg)/URDF/base.urdf.xacro" />
    <xacro:include filename="$(find interestelar_pkg)/URDF/tripode.urdf.xacro" />

    <!-- ========= Xacro include  =========-->
    <xacro:tripode link="tripode" />
    <xacro:antena link1="base" link2="motor_dc" link3="stepper" 
                 joint1="azimuth" joint2="elevacion"/>
    
     <!-- ========= Wold  =========-->
    <link name="world" />
    
    <joint name="base_to_world" type="fixed">
      <parent link="world" />
      <child link="tripode" />
      <origin xyz="0 0 0" />
    </joint>

   <!-- ========= Tripod Joint  =========-->
   <joint name="base_to_tripod" type="fixed">
      <parent link="tripode" />
      <child link="base" />
      <origin xyz="0 0 1.18374" />
   </joint>




    
</robot>